{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/", "destination": "/platform", "permanent": false }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/platform" },
    { "source": "/app", "destination": "/platform/app" },
    { "source": "/owner", "destination": "/platform/owner" },
    { "source": "/r/:slug", "destination": "/platform/r" }
  ]
}
