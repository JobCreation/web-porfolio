{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "이력서 플랫폼 실행 (F5)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dev-server.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": { "pattern": "http://127.0.0.1:([0-9]+)", "uriFormat": "http://127.0.0.1:%s/", "action": "openExternally" }
    }
  ]
}
